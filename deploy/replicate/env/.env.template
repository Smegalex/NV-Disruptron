# NV-Disruptron — replication .env template
# Copy to repo root:  cp deploy/replicate/env/.env.template .env

# Required for voice alerts
ELEVENLABS_API_KEY=

# Context / token budget (256k default)
VLLM_MAX_MODEL_LEN=262144
DISRUPTRON_CONTEXT_WINDOW=262144
VLLM_MULTIMODAL=1
VLLM_SERVED_MODEL=nemotron-3-nano-omni
NEMOCLAW_REASONING=1

# vLLM Docker (aarch64 Spark default)
VLLM_IMAGE=vllm/vllm-openai:v0.20.0-aarch64-cu130-ubuntu2404
VLLM_BASE_URL=http://127.0.0.1:8000/v1
# VLLM_GPU_UTIL=0.89
# VLLM_MAX_NUM_SEQS=1

# If OOM on smaller GPU:
# VLLM_MAX_MODEL_LEN=131072
# VLLM_GPU_UTIL=0.55

# OpenClaw heartbeat
DISRUPTRON_HEARTBEAT_EVERY=10m

# Google Calendar MCP
DISRUPTRON_GOOGLE_CALENDAR=1
GOOGLE_CALENDAR_MCP_DIR=~/google-calendar-mcp
GOOGLE_CALENDAR_MCP_PORT=3000

# Telegram (BotFather)
TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOW_FROM=

# Optional voice
# ELEVENLABS_VOICE_ID=pMsXgVXv3BLzUgSXRplE
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Token budget overrides (usually auto-computed by configure)
# DISRUPTRON_MEMORY_FLUSH_THRESHOLD=8000
# DISRUPTRON_KEEP_RECENT_RATIO=0.10

# TfL (optional)
# TFL_APP_KEY=

# AI-Q sidecar (optional)
# AIQ_SERVER_PORT=8001
